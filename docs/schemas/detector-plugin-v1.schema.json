{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswayneh/RedDock/blob/master/docs/schemas/detector-plugin-v1.schema.json",
  "title": "RedDock data-only detector plugin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "title", "description", "rules"],
  "properties": {
    "schema": { "const": "reddock.detector-plugin/1" },
    "id": {
      "type": "string",
      "pattern": "^plugin\\.[a-z0-9][a-z0-9._-]{0,55}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9][0-9A-Za-z._-]{0,15}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observation_type",
        "detail_key",
        "equals",
        "title",
        "description",
        "category",
        "severity",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "observation_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "detail_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "equals": { "type": ["string", "integer", "boolean"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "description": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "category": {
          "enum": ["transport", "hardening", "information_disclosure"]
        },
        "severity": {
          "enum": ["informational", "low", "medium", "high", "critical"]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "remediation": {
          "type": ["string", "null"],
          "maxLength": 1500
        }
      }
    }
  }
}
